
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <GameDir>$(HOME)/.steam/steam/steamapps/common/Hollow Knight Silksong</GameDir>
    <ManagedDir>$(GameDir)/Hollow Knight Silksong_Data/Managed</ManagedDir>
    <BepInExDir>$(GameDir)/BepInEx/core</BepInExDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>


    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="PlayMaker">
      <HintPath>$(ManagedDir)/PlayMaker.dll</HintPath>
      <Private>false</Private>
    </Reference>

  </ItemGroup>
  <ItemGroup>
      <Compile Remove="decompiled/**/*.cs" />
  </ItemGroup>
</Project>
